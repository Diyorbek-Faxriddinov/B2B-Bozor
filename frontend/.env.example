# Backend API manzili. Bo'sh qoldirilsa yoki VITE_USE_MOCK=true bo'lsa — brauzer ichidagi mock server ishlaydi.
VITE_API_URL=http://localhost:4000/api/v1
VITE_USE_MOCK=true

# Geo-servislar (bo'sh qoldirilsa — ochiq demo serverlar ishlatiladi).
# Production'da o'z OSRM serveringizni yoki backend proxy'ni ko'rsating.
VITE_OSRM_URL=https://router.project-osrm.org
VITE_PHOTON_URL=https://photon.komoot.io
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
