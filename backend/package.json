{
  "name": "b2b-bozor-api",
  "version": "1.0.0",
  "private": true,
  "description": "B2B Bozor REST API (NestJS + Prisma + MySQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --config test/jest-e2e.config.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mysql2": "^3.24.6",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "overrides": {
    "multer": "^2.5.0",
    "js-yaml@5": "^5.4.1",
    "deepmerge-ts": "^8.0.0"
  }
}
