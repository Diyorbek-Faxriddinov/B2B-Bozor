# ─────────────────────────────────────────────────────────────
#  B2B Bozor API — muhit sozlamalari
#  Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
#  .env hech qachon git'ga qo'shilmaydi.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Backend'ning tashqi manzili (yuklangan fayllar URL'i va to'lov callback'lari uchun)
APP_URL=http://localhost:4000
# Frontend manzili (email havolalari, CORS)
FRONTEND_URL=http://localhost:5173
# Vergul bilan ajratilgan ruxsat etilgan originlar
CORS_ORIGINS=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────
# Faqat `npm run db:setup` uchun: root paroli bilan baza va alohida
# b2b_app foydalanuvchisi yaratiladi, DATABASE_URL avtomatik yoziladi.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
# setup skripti to'ldiradi (qo'lda ham yozish mumkin)
DATABASE_URL=
TEST_DATABASE_URL=
SHADOW_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────
# Kamida 32 belgi. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── AI yordamchi (Anthropic Claude) ──────────────────────────
# Bo'sh qoldirilsa — qoidaga asoslangan zaxira javoblar ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Email (SMTP) ─────────────────────────────────────────────
# Bo'sh qoldirilsa — xatlar konsolga yoziladi.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS = App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="B2B Bozor <no-reply@b2bbozor.uz>"
# Bu domenlarga xat yuborilmaydi, faqat konsolga yoziladi (demo hisoblar)
MAIL_SKIP_DOMAINS=demo.uz,example.com

# ── SMS (Eskiz.uz) ───────────────────────────────────────────
# Bo'sh qoldirilsa — SMS'lar konsolga yoziladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── Payme (Merchant API) ─────────────────────────────────────
# Kabinet: business.payme.uz. Bo'sh bo'lsa — to'lov simulyatsiyasi.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_TEST_MODE=true

# ── Click (SHOP API) ─────────────────────────────────────────
# Kabinet: merchant.click.uz. Bo'sh bo'lsa — to'lov simulyatsiyasi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# ── Geo ──────────────────────────────────────────────────────
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ── Fayllar ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
